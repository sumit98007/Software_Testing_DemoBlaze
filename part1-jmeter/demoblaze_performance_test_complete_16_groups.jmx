          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Base64
if (!vars.get(&apos;unique_username&apos;)) {
    def u = &quot;testuser${ctx.getThreadNum()}_${System.currentTimeMillis()}_${(int) (Math.random()*1000)}&quot;
    vars.put(&apos;unique_username&apos;, u)
    vars.put(&apos;prod_id&apos;, &apos;14&apos;)
    vars.put(&apos;cookie_token&apos;, Base64.getEncoder().encodeToString(u.bytes))
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">false</stringProp>
        </JSR223PreProcessor>
