        <!-- JSR223 PreProcessor to generate new UUID per iteration for Add to Cart -->
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate New UUID for Add to Cart" enabled="true">
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.UUID;
import java.util.Base64;

// Generate new UUID for this iteration
String newUserId = UUID.randomUUID().toString();
vars.put("user_id", newUserId);

// Generate Base64 encoded username for cookie (must match logged-in user)
String username = vars.get("unique_username");
String encodedUsername = Base64.getEncoder().encodeToString(username.getBytes());
vars.put("cookie_token", encodedUsername);

log.info("Generated new UUID for Add to Cart: " + newUserId + ", cookie: " + encodedUsername);</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
