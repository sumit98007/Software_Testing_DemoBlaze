        <hashTree>
          <!-- JSR223 PreProcessor to generate per-run credentials and cart variables -->
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Per-Run Variables" enabled="true">
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.util.UUID;
import java.util.Base64;
import java.util.Random;

// Only set variables if they don't already exist (guard)
if (vars.get("unique_username") == null) {
    // Generate unique username for this specific request
    String threadNum = String.valueOf(ctx.getThreadNum());
    String timestamp = String.valueOf(System.currentTimeMillis());
    String randomSuffix = String.valueOf(new Random().nextInt(1000));
    String uniqueUsername = "testuser" + threadNum + "_" + timestamp + "_" + randomSuffix;

    // Generate unique user ID for this specific request
    String userId = UUID.randomUUID().toString();

    // Generate Base64 encoded username for cookie
    String encodedUsername = Base64.getEncoder().encodeToString(uniqueUsername.getBytes());

    // Set variables for this request
    vars.put("unique_username", uniqueUsername);
    vars.put("user_id", userId);
    vars.put("cookie_token", encodedUsername);
    vars.put("prod_id", "14");

    log.info("Generated unique credentials for Thread " + threadNum + ": username=" + uniqueUsername + ", user_id=" + userId);
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
